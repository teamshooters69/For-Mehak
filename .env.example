# ==============================================================================
# Mehak's Little Universe — Server & Deployment Environment Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# You MUST update ADMIN_USERNAME, ADMIN_PASSWORD, and SESSION_SECRET with your
# own private, unique values BEFORE deploying to Vercel or any public host.
# Never commit your real .env file or share your admin password with anyone.
# ==============================================================================

# Local server port (AI Studio & Node hosting use 3000)
PORT=3000

# Private access passcode for Mehak to unlock the universe gate
UNIVERSE_ACCESS_CODE="mehak"

# Owner-only credentials for /admin and /owner-admin (verified strictly on backend)
# MUST BE CHANGED BEFORE DEPLOYMENT!
ADMIN_USERNAME="owner"
ADMIN_PASSWORD="MLU#Owner!9xK2$vP7qR4wZ8"

# Strong random secret (32+ characters) used to sign HttpOnly session cookies
# MUST BE CHANGED BEFORE DEPLOYMENT!
SESSION_SECRET="replace-with-a-64-character-random-secret-before-deploying-live"

# Optional external URL where this app is hosted (e.g. your Vercel domain)
APP_URL="http://localhost:3000"

# Optional (Recommended for Vercel deployments):
# Connect Upstash Redis / Vercel KV in Vercel Marketplace to persist Mehak's
# answers, quiz results, games, and session history permanently across restarts.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
